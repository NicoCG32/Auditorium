# Configuración pública del proyecto. Nunca usar una clave secret ni service_role.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Servicio de metadatos para builds estáticos (opcional). No incluye claves.
# En desarrollo Vite ofrece /api/musicbrainz automáticamente.
# VITE_MUSICBRAINZ_PROXY_URL=https://catalog.example.com/api/musicbrainz
# Alternativa Supabase: https://your-project.supabase.co/functions/v1/musicbrainz
# Usa las dos variables públicas del mismo proyecto indicadas arriba; docs/CATALOGO_SUPABASE.md.
# Servicio independiente: npm run catalog:serve. Un único proceso coordina las consultas.
# CATALOG_HOST=127.0.0.1
# CATALOG_PORT=4190
# CATALOG_ALLOWED_ORIGINS=https://nicocg32.github.io
